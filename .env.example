# Server Configuration
PORT=8080

# LLM Provider Configuration
# Supported providers: "openai", "anthropic", "mock" (offline heuristic parser)
LLM_PROVIDER=openai

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Settings (Optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Downstream Mock Integration Endpoints
FREEE_API_URL=http://localhost:8080/mock/freee/expense
CHATWORK_API_URL=http://localhost:8080/mock/chatwork/message

# Mock API Simulated Network Latency (milliseconds)
MOCK_API_DELAY_MS=150
